# Copy to .env and adjust. Every value here has a working default for local development.
DEBUG=true
SECRET_KEY=dev-only-secret-key-do-not-use-in-production
DATABASE_URL=postgres://cohort:cohort@127.0.0.1:5442/cohort

SITE_NAME=Cohort App
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Emails print to the terminal until you set a real SMTP host.
# Email is on when DEBUG is on, and off otherwise. With it off, sign-up skips the confirmation link and
# password reset tells people to contact support.
# EMAIL_ENABLED=false
# To send real email through Resend (free tier), uncomment these and paste your API key as the password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_your_api_key
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Cohort App <onboarding@resend.dev>

# Staging on Railway: set these on the service, not here. docs/staging.md has the full list.
# DEBUG=false
# SECRET_KEY=<long random string>
# ALLOWED_HOSTS=your-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# FRONTEND_URL=https://your-app.up.railway.app
